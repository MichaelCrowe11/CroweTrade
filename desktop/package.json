{
  "name": "crowetrade-terminal",
  "productName": "CroweTrade",
  "version": "0.2.8",
  "private": true,
  "description": "CroweTrade operator terminal",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c gray,yellow \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5273 && tsc -p electron/tsconfig.json && electron .",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts' 'electron/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "motion": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.2",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.crowelogic.crowetrade",
    "productName": "CroweTrade",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts/nb_runner.py",
        "to": "scripts/nb_runner.py"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "CroweTrade-${version}-${arch}.${ext}"
    }
  }
}