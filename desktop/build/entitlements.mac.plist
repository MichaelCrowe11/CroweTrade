<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime entitlements for Developer ID notarized distribution.
       The JIT pair is what Electron's V8 needs to run under the hardened
       runtime; without them a signed build can crash at launch on a customer
       Mac. Library validation stays disabled because Electron's framework
       layout requires it. Nothing else: this terminal reads markets and asks
       an analyst, it has no microphone, camera, or automation entitlement to
       justify. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
