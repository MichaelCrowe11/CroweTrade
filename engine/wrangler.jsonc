{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crowetrade-engine",
  "main": "src/index.ts",
  "account_id": "9f3b1ed688d960bc9ea03569ca840dfd",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // The Analyst runs HERE, not in the desktop app. Azure pulled the Foundry
  // credits on 2026-08-09 and took the Analyst down with them; hosting the loop
  // in the Worker also means no model credential ever ships inside a desktop
  // binary, and the tools read the Durable Object in-process instead of looping
  // back over HTTP.
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "crowetrade-archive" }],
  // Declared so `wrangler types` puts them on Env. The VALUES are secrets set
  // with `wrangler secret put` and never live in this file. Both are absent
  // until the dust test, which leaves the live path structurally inert.
  "vars": {},
  "triggers": { "crons": ["* * * * *"] },
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }]
}
